// Copy to Config/Secrets.xcconfig (gitignored) and fill in only what you need.
// With no values set, the app runs on the on-device model alone.

// Your Apple developer team and a bundle ID registered to it (needed to run on a device).
DEVELOPMENT_TEAM =
HR_BUNDLE_ID = dev.hybridrouter.HybridRouter

// Claude, option 1: developer key for Simulator and local debug builds. Release builds ignore it.
ANTHROPIC_API_KEY =

// Claude, option 2: Anthropic Console client ID for App Attest (device builds).
CLAUDE_CLIENT_ID =

// Apple Cloud: only if Apple granted your team the Private Cloud Compute entitlement.
// HR_APPLE_CLOUD_ENABLED = YES

// Entitlements: pick the file matching what you enabled above (default: none).
//   App Attest only:              CODE_SIGN_ENTITLEMENTS = Config/AppAttest.entitlements
//   Apple Cloud only:             CODE_SIGN_ENTITLEMENTS = Config/AppleCloud.entitlements
//   App Attest and Apple Cloud:   CODE_SIGN_ENTITLEMENTS = Config/AppAttestAppleCloud.entitlements
